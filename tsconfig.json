{
  "compilerOptions": {
    "target": "es2024",
    "jsx": "preserve",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "strictFunctionTypes": true,
    "importHelpers": true,
    "removeComments": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },

  "exclude": ["node_modules", "**/node_modules/*"]
}
